{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "constraints": {
    "python": "3.14.7"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "description": "Bundle pyproject.toml / uv.lock dependency updates",
      "groupName": "python",
      "matchManagers": [
        "pep621"
      ]
    },
    {
      "description": "Bundle Astral tooling and Python runtime image updates",
      "groupName": "python",
      "matchPackageNames": [
        "ghcr.io/astral-sh/uv",
        "astral-sh/ruff-action",
        "astral-sh/ruff-pre-commit",
        "python"
      ]
    }
  ]
}
